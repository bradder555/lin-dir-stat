{
  "name": "lin-dir-stat-electron",
  "private": true,
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.bradp.lin-dir-stat",
    "productName": "LinDirStat",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": ["main.js", "package.json"],
    "extraResources": [
      { "from": "../server", "to": "server", "filter": ["**/*", "!*.log"] },
      { "from": "../client/dist", "to": "client/dist" }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    }
  }
}
